              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{productsUrl}}/api/products",
              "host": [
                "{{productsUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"{{storeId}}\",\n  \"productCode\": \"SKU-{{runId}}\",\n  \"name\": \"Chimarrao cuia\",\n  \"description\": \"Hand made, 300ml\",\n  \"price\": 49.9,\n  \"quantity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The currency is not sent: the stored procedure copies it from the store."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"runId\")) {",
                  "    pm.collectionVariables.set(\"runId\", Date.now().toString().slice(-6));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const product = pm.response.json();",
                  "pm.test(\"currency comes from the store\", () => pm.expect(product.currencyCode).to.eql(pm.environment.get(\"storeCurrency\")));",
                  "pm.test(\"Location header points to the new product\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.include(product.id);",
                  "});",
                  "pm.collectionVariables.set(\"productId\", product.id);"
                ]
              }
            }
          ]
        },
