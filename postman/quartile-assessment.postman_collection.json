                  "pm.test(\"store currency is on the root\", () => pm.expect(body.currencyCode).to.eql(pm.environment.get(\"storeCurrency\")));",
                  "pm.test(\"contains the product created above\", () => {",
                  "    // SQL Server returns GUIDs in upper case",
                  "    const ids = body.products.map(p => p.id.toLowerCase());",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get(\"productId\").toLowerCase());",
