        {
          "name": "Create company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{storesUrl}}/api/companies",
              "host": [
                "{{storesUrl}}"
              ],
              "path": [
                "api",
                "companies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Retail {{runId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// unique suffix so the collection can be run more than once",
                  "pm.collectionVariables.set(\"runId\", Date.now().toString().slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const company = pm.response.json();",
                  "pm.test(\"has an id and the name sent\", () => {",
                  "    pm.expect(company.id).to.be.a(\"string\");",
                  "    pm.expect(company.name).to.eql(`Acme Retail ${pm.collectionVariables.get(\"runId\")}`);",
                  "});",
                  "pm.test(\"Location header points to the new company\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.include(company.id);",
                  "});",
                  "pm.collectionVariables.set(\"companyId\", company.id);"
                ]
              }
            }
          ]
        },
