    {
      "name": "3. Cross-service (production only)",
      "item": [
        {
          "name": "Change currency of a store with products -> 409",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{storesUrl}}/api/companies/{{companyId}}/stores/{{storeId}}",
              "host": [
                "{{storesUrl}}"
              ],
              "path": [
                "api",
                "companies",
                "{{companyId}}",
                "stores",
                "{{storeId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Porto Alegre - Centro\",\n  \"countryCode\": \"BR\",\n  \"currencyCode\": \"USD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Api-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "description": "The Stores API doesn't know about products. The composite FK Products(StoreId, CurrencyCode) -> Stores(Id, CurrencyCode) rejects the update and the API maps it to 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"returns a problem details body\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    pm.expect(pm.response.json()).to.have.property(\"title\");",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Shows the rule between the two services working through the database."
    },
